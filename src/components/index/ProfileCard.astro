  <div class="avatar-container">
    <img src="/profile.png" alt="Nayuki" class="avatar" onerror="this.src='https://ui-avatars.com/api/?name=Nayuki&background=0D8ABC&color=fff'"/>
  </div>
  <div class="profile-info">
    <h1 class="profile-name">卟瓿钚</h1>

    <div class="profile-links">
      <a href="https://github.com/NayukiChiba" target="_blank" aria-label="GitHub" style="--link-index: 0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
      </a>
      <a href="https://x.com/NayeyChiba" target="_blank" aria-label="Twitter" style="--link-index: 1">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
      </a>
      <a href="mailto:MekoNayuki@gmail.com" aria-label="Email" style="--link-index: 2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .profile-content {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .avatar-container {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: visible;
    flex-shrink: 0;
    position: relative;
    cursor: pointer;
  }

  /* 纯色淡描边环：贴在头像白边外侧 */
  .avatar-container::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-primary), transparent 70%);
    z-index: 1;
    pointer-events: none;
    transition: transform 0.4s var(--ease-spring);
  }

  .avatar-container:hover::before {
    transform: scale(1.06);
  }

  /* 头像图片 */
  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--color-card-bg);
    box-shadow: var(--shadow-md);
    position: relative;
    z-index: 2;
    transition: box-shadow 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }

  /* hover：旋转保留，阴影保持中性 */
  .avatar-container:hover .avatar {
    animation: avatarSpin 1.5s linear infinite;
    box-shadow: var(--shadow-hover);
  }

  @keyframes avatarSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .profile-info {
    flex: 1;
  }

  /* 名字字符动画 */
  .profile-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
    display: flex;
  }

  .name-char {
    display: inline-block;
    animation: nameWave 3s ease-in-out infinite;
    animation-delay: calc(var(--char-index) * 0.15s);
  }

  @keyframes nameWave {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .name-char:hover {
    color: var(--color-primary);
    animation: charBounce 0.5s ease;
  }

  @keyframes charBounce {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.2); }
  }

  .profile-links {
    display: flex;
    gap: 0.625rem;
  }

  /* 社交按钮：几何圆角方形，统一 hover 主题浅底 + 上浮 */
  .profile-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text-light);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    transition:
      color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.3s var(--ease-out);
    border: 1px solid transparent;
  }

  .profile-links a:hover {
    transform: translateY(-3px);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary), transparent 90%);
    border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
    animation: iconJiggle 0.4s var(--ease-out);
  }

  @keyframes iconJiggle {
    0%, 100% { transform: translateY(-3px) rotate(0deg); }
    25% { transform: translateY(-5px) rotate(-8deg); }
    75% { transform: translateY(-5px) rotate(8deg); }
  }

  /* 减少动画偏好 */
  @media (prefers-reduced-motion: reduce) {
    .avatar-container:hover .avatar,
    .name-char,
    .profile-links a {
      animation: none !important;
    }
    .avatar-container::before,
    .avatar,
    .profile-links a {
      transition: none;
    }
    .avatar-container:hover .avatar {
      transform: scale(1.05);
    }
  }

  /* 全局动画开关：关闭循环动画（头像旋转 / 名字波浪） */
  :global(html.fx-anim-off) .avatar-container:hover .avatar,
  :global(html.fx-anim-off) .name-char {
    animation: none !important;
  }

  @media (min-width: 640px) {
    .avatar-container {
      width: 100px;
      height: 100px;
    }
  }

  @media (min-width: 768px) {
    .profile-content {
      flex: 0 0 25%;
      min-width: 260px;
    }
  }

  /* 移动端：竖排居中 */
  @media (max-width: 767px) {
    .profile-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .profile-name {
      justify-content: center;
    }

    .profile-links {
      justify-content: center;
    }
  }
</style>



