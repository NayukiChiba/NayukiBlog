---
interface Todo {
  id: string | number;
  task: string;
  completed: boolean;
  priority?: string;
  type?: string;
}

interface Props {
  todos?: Todo[];
}

const { todos = [] } = Astro.props;

// Filter: Only show active (not completed) short-term tasks
const displayTodos = todos.filter(t => !t.completed && t.type === 'short-term');
---

<div class="todo-card">
  <div class="todo-header">
    <span class="todo-title">Short-term Goals</span>
  </div>
  <div class="todo-list">
    {displayTodos.length > 0 ? (
      displayTodos.map(todo => (
        <div class="todo-item">
          <div class="todo-checkbox"></div>
          <span class="todo-text">{todo.task}</span>
        </div>
      ))
    ) : (
      <div class="empty-text">No active tasks</div>
    )}
  </div>
</div>

<style>
  /* Todo Card Styles */
  .todo-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    height: 160px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
    box-shadow: var(--shadow-xs);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
    position: relative;
    overflow: visible;
  }

  .todo-card:hover {
    border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .todo-header {
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* overline 标题：前置 45° 纯色小方块 */
  .todo-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .todo-title::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--color-primary);
    opacity: 0.85;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .todo-list {
    overflow-y: auto;
    flex: 1;
    padding-right: 4px;
  }

  /* Custom Scrollbar for Todo List */
  .todo-list::-webkit-scrollbar {
    width: 4px;
  }
  .todo-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .todo-list::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }
  .todo-list::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--radial-c1), var(--color-border) 50%);
  }

  .todo-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    cursor: default;
    transition: padding-left 0.2s var(--ease-out);
  }

  .todo-item:hover {
    padding-left: 0.25rem;
  }

  .todo-checkbox {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      transform 0.3s var(--ease-spring);
  }

  .todo-item:hover .todo-checkbox {
    border-color: color-mix(in srgb, var(--radial-c1), transparent 30%);
    background: color-mix(in srgb, var(--radial-c1), transparent 90%);
    transform: scale(1.1);
  }

  .todo-text {
    font-size: 0.875rem;
    color: var(--color-text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.5;
  }

  .empty-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    padding-top: 1.5rem;
    font-style: italic;
  }

  @media (min-width: 768px) {
    .todo-card {
      width: 220px;
      flex-shrink: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .todo-card,
    .todo-item,
    .todo-checkbox {
      transition: none;
    }
  }
</style>
