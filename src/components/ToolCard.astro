---
interface Props {
    name: string;
    description?: string;
    url?: string;
    icon?: string;
}

const { name, description = '', url = '#', icon = '🔧' } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="tool-card">
    <div class="tool-icon">
        {
            icon && icon.startsWith("<svg") ? (
                <Fragment set:html={icon} />
            ) : icon && (icon.startsWith("http") || icon.startsWith("/")) ? (
                <img src={icon} alt={name} class="tool-icon-img" />
            ) : (
                <span class="emoji-icon">{icon || "🔧"}</span>
            )
        }
    </div>
    <div class="tool-content">
        <div class="tool-header">
            <h3 class="tool-name">{name}</h3>
        </div>
        <p class="tool-desc">{description}</p>
    </div>
</a>

<style>
    .tool-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 1.2rem;
        text-decoration: none;
        box-shadow: var(--shadow-xs);
        transition:
            transform 0.3s var(--ease-out),
            border-color 0.3s var(--ease-out),
            box-shadow 0.3s var(--ease-out);
        height: 100%;
        box-sizing: border-box;
        overflow: hidden;
    }

    .tool-card:hover {
        border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
    }

    /* 图标容器：几何圆角方形；hover 主题浅底 + 弹性微转 */
    .tool-icon {
        width: 48px;
        height: 48px;
        background: var(--color-bg-secondary);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
        transition:
            background-color 0.25s var(--ease-out),
            transform 0.35s var(--ease-spring);
    }

    .tool-card:hover .tool-icon {
        background: color-mix(in srgb, var(--radial-c1), transparent 90%);
        transform: rotate(-5deg) scale(1.06);
    }

    .tool-icon :global(svg) {
        width: 24px;
        height: 24px;
    }

    .tool-icon-img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .emoji-icon {
        font-size: 1.5rem;
    }

    .tool-content {
        flex: 1;
        min-width: 0; /* Prevent text overflow issues */
    }

    .tool-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.3rem;
    }

    .tool-name {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-text);
        letter-spacing: -0.01em;
        transition: color 0.2s var(--ease-out);
    }

    .tool-card:hover .tool-name {
        color: var(--color-primary);
    }

    .tool-desc {
        margin: 0;
        font-size: 0.9rem;
        color: var(--color-text-light);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
        .tool-card,
        .tool-icon,
        .tool-name {
            transition: none;
        }
    }
</style>
