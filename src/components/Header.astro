---
const navItems = [
  { href: '/home', label: 'Home' },
  { href: '/articles', label: 'Articles' },
  { href: '/projects', label: 'Projects' },
  { href: '/diary', label: 'Diary' },
  { href: '/library', label: 'Library' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/todo', label: 'TODO' },
  { href: '/toolbox', label: 'Tools' },
  { href: '/rss', label: 'RSS' },
  { href: '/about', label: 'About' },
];

// 归一化路径：静态构建（directory 格式）时 pathname 带尾斜杠（如 /home/），
// 去掉尾斜杠再比较，保证本地 dev 与部署后 active 高亮行为一致
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/home" class="site-logo" aria-label="返回首页">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-text">Nayuki</span>
    </a>

    <!-- 桌面端导航（顶栏水平） -->
    <nav class="desktop-nav">
      <ul class="nav-list">
        {navItems.map(item => (
          <li>
            <a href={item.href} class={currentPath === item.href ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 移动端汉堡菜单按钮 -->
    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="打开菜单">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- 移动端导航抽屉 -->
    <nav class="mobile-nav" id="mobile-nav">
      <div class="mobile-nav-header">
        <span class="mobile-nav-title">导航</span>
        <button class="mobile-nav-close" id="mobile-nav-close" aria-label="关闭菜单">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <ul class="mobile-nav-list">
        {navItems.map(item => (
          <li>
            <a href={item.href} class={currentPath === item.href ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- 移动端导航遮罩层 - 放在 header 外面确保覆盖整个页面 -->
<div class="mobile-nav-overlay" id="mobile-nav-overlay"></div>

<style>
  /* =========================================
     顶部玻璃导航条（Fuwari 式）
     ========================================= */
  .site-header {
    background: var(--surface-glass, rgba(255, 255, 255, 0.78));
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 0;
    z-index: 1000;
    transition: transform 0.32s var(--ease-out, ease);
  }

  .site-header.hidden {
    transform: translateY(-100%);
  }

  .header-container {
    max-width: var(--page-max, min(1440px, 92vw));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 0;
  }

  /* ===== Logo ===== */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* Logo 几何标记：墨蓝旋转方块 + 白色圆孔 */
  .logo-mark {
    position: relative;
    width: 15px;
    height: 15px;
    border-radius: 4.5px;
    background: var(--color-primary, #4c5670);
    transform: rotate(45deg);
    transition: transform 0.45s var(--ease-spring, ease);
  }

  .logo-mark::after {
    content: '';
    position: absolute;
    inset: 4.5px;
    border-radius: 50%;
    background: #ffffff;
  }

  .site-logo:hover .logo-mark {
    transform: rotate(225deg);
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .site-logo:hover .logo-text {
    color: var(--color-primary);
  }

  /* ===== 桌面端导航 ===== */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-list a {
    position: relative;
    color: var(--color-text-light);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-full, 999px);
    transition: color 0.2s var(--ease-out, ease), background-color 0.2s var(--ease-out, ease);
    white-space: nowrap;
  }

  .nav-list a:not(.active):hover {
    color: var(--color-text);
    background-color: var(--color-bg-secondary);
  }

  .nav-list a.active {
    color: var(--color-text);
    font-weight: 600;
    background-color: var(--color-primary-subtle);
  }

  .nav-list a.active::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 1px;
    width: 14px;
    height: 2.5px;
    border-radius: 999px;
    background: var(--color-primary);
    opacity: 0.9;
  }

  /* ===== 移动端汉堡菜单按钮 ===== */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 101;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text, #1a1d24);
    border-radius: 2px;
    transition: all 0.3s var(--ease-out, ease);
  }

  /* 三条线宽度错落，展开后归一 */
  .hamburger-line:nth-child(2) {
    width: 72%;
    align-self: flex-end;
  }

  .mobile-menu-btn.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  /* ===== 移动端遮罩层（元素在 header 外部，需 :global） ===== */
  :global(.mobile-nav-overlay) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(26, 29, 36, 0.4);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  :global(.mobile-nav-overlay.active) {
    opacity: 1;
    visibility: visible;
  }

  /* ===== 移动端导航抽屉 ===== */
  .mobile-nav {
    position: fixed;
    top: 0;
    right: 0;
    width: 280px;
    height: 100vh;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    z-index: 999;
    transform: translateX(100%);
    transition: transform 0.32s var(--ease-out, ease), visibility 0.32s ease;
    box-shadow: -10px 0 32px rgba(26, 29, 36, 0.12);
    border-left: 1px solid var(--color-border-light);
    overflow-y: auto;
    visibility: hidden;
  }

  .mobile-nav.active {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.05rem 1.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .mobile-nav-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
  }

  .mobile-nav-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    border-radius: 50%;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-nav-close:hover {
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-nav-list a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-text-light);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius-md, 12px);
    transition: all 0.2s var(--ease-out, ease);
    position: relative;
  }

  .mobile-nav-list a:hover {
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .mobile-nav-list a.active {
    color: var(--color-text);
    font-weight: 600;
    background-color: var(--color-primary-subtle);
  }

  .mobile-nav-list a.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 55%;
    border-radius: 999px;
    background: var(--color-primary);
  }

  /* 桌面端（≥1024px）：整个顶栏隐藏，导航由左侧信息栏的菜单卡承担 */
  @media (min-width: 1024px) {
    .site-header {
      display: none;
    }

    .mobile-nav {
      display: none !important;
    }

    :global(.mobile-nav-overlay) {
      display: none !important;
    }
  }

  /* 小屏幕：顶栏内容全宽 + 侧边距 */
  @media (max-width: 1023px) {
    .header-container {
      max-width: 100%;
      padding: 0.8rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .logo-mark,
    .mobile-nav,
    .mobile-nav-close,
    .mobile-nav-list a,
    .nav-list a {
      transition: none;
    }
  }
</style>

<script>
  // Header scroll behavior
  let lastScrollY = window.scrollY;
  const header = document.querySelector('.site-header');

  if (header) {
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;

      // 向下滚动且滚动距离超过20px时隐藏，向上滚动时显示
      if (currentScrollY > lastScrollY && currentScrollY > 20) {
        header.classList.add('hidden');
      } else {
        header.classList.remove('hidden');
      }

      lastScrollY = currentScrollY;
    });
  }

  // 移动端菜单逻辑
  function initMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileNavOverlay = document.getElementById('mobile-nav-overlay');
    const mobileNavClose = document.getElementById('mobile-nav-close');

    // 确保菜单初始状态是关闭的
    mobileNav?.classList.remove('active');
    mobileNavOverlay?.classList.remove('active');
    mobileMenuBtn?.classList.remove('active');

    function openMobileMenu() {
      mobileMenuBtn?.classList.add('active');
      mobileNav?.classList.add('active');
      mobileNavOverlay?.classList.add('active');
      // 锁定页面滚动
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      mobileMenuBtn?.classList.remove('active');
      mobileNav?.classList.remove('active');
      mobileNavOverlay?.classList.remove('active');
      // 恢复页面滚动
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }

    mobileMenuBtn?.addEventListener('click', () => {
      if (mobileNav?.classList.contains('active')) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    mobileNavClose?.addEventListener('click', closeMobileMenu);
    mobileNavOverlay?.addEventListener('click', closeMobileMenu);

    // 点击导航链接后关闭菜单
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-list a');
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  }

  // 初始化移动端菜单
  initMobileMenu();
</script>
