---
// 右侧信息栏 — david03 式趣味栏
// 最近文章卡 + 博客信息统计卡 + 随机传送按钮；随页面滚动（外层 aside 控制 sticky）

interface RecentPost {
  title: string;
  url: string;
  date: string;
  image?: string;
}

interface Props {
  recentPosts?: RecentPost[];
  stats?: {
    articles: number;
    tags: number;
    categories: number;
  };
}

const { recentPosts = [], stats = { articles: 0, tags: 0, categories: 0 } } = Astro.props;

// 随机传送候选（传给客户端脚本）
const randomUrls = recentPosts.map((p) => p.url);

function fmtDate(date: string): string {
  const d = new Date(date);
  if (isNaN(d.getTime())) return date;
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
---

<div class="aside-stack-right">
  <!-- 最近文章卡 -->
  <div class="aside-card recent-card">
    <span class="card-label">最近文章</span>
    <ul class="recent-list">
      {recentPosts.slice(0, 5).map((post) => (
        <li>
          <a href={post.url} class="recent-item" data-astro-prefetch="hover">
            <span class="recent-thumb">
              {post.image ? (
                <img src={post.image} alt="" loading="lazy" />
              ) : (
                <span class="thumb-mark" aria-hidden="true"></span>
              )}
            </span>
            <span class="recent-info">
              <span class="recent-title">{post.title}</span>
              <span class="recent-date">{fmtDate(post.date)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- 博客信息卡 -->
  <div class="aside-card info-card">
    <span class="card-label">博客信息</span>
    <ul class="info-list">
      <li>
        <span class="info-name">文章数目</span>
        <span class="info-pill">{stats.articles}</span>
      </li>
      <li>
        <span class="info-name">标签数目</span>
        <span class="info-pill">{stats.tags}</span>
      </li>
      <li>
        <span class="info-name">分类数目</span>
        <span class="info-pill">{stats.categories}</span>
      </li>
      <li>
        <span class="info-name">运行天数</span>
        <span class="info-pill" id="uptime-days">—</span>
      </li>
    </ul>
  </div>

  <!-- 随机传送 -->
  <button class="aside-card random-card" id="random-post-btn" data-urls={JSON.stringify(randomUrls)}>
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"></circle><circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"></circle><circle cx="8.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"></circle><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"></circle><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"></circle></svg>
    <span>随机传送一篇文章</span>
  </button>
</div>

<style>
  .aside-stack-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .aside-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    padding: 1rem 1.1rem 1.1rem;
  }

  .card-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
  }

  /* ===== 最近文章 ===== */
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.45rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.2s var(--ease-out, ease);
  }

  .recent-item:hover {
    background: var(--color-bg-secondary);
  }

  .recent-thumb {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 9px;
    overflow: hidden;
    background: var(--color-bg-secondary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recent-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 无封面时的几何占位 */
  .thumb-mark {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: var(--color-primary);
    opacity: 0.35;
    transform: rotate(45deg);
  }

  .recent-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .recent-title {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-light);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .recent-item:hover .recent-title {
    color: var(--color-primary);
  }

  .recent-date {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ===== 博客信息 ===== */
  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .info-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
  }

  .info-name {
    color: var(--color-text-light);
  }

  .info-pill {
    min-width: 2.2rem;
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-secondary);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* ===== 随机传送 ===== */
  .random-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-light);
    cursor: pointer;
    font-family: inherit;
    transition:
      color 0.2s var(--ease-out, ease),
      border-color 0.2s var(--ease-out, ease),
      transform 0.2s var(--ease-out, ease),
      box-shadow 0.2s var(--ease-out, ease);
  }

  .random-card svg {
    color: var(--color-text-muted);
    transition: color 0.2s ease, transform 0.3s var(--ease-spring, ease);
  }

  .random-card:hover {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .random-card:hover svg {
    color: var(--color-primary);
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-item,
    .random-card,
    .random-card svg {
      transition: none;
    }
  }
</style>

<script>
  // 随机传送：从最近文章列表中随机跳转一篇
  function initRandomPost() {
    const btn = document.getElementById('random-post-btn');
    if (!btn) return;

    btn.addEventListener('click', () => {
      try {
        const urls: string[] = JSON.parse(btn.dataset.urls || '[]');
        if (urls.length === 0) return;
        const target = urls[Math.floor(Math.random() * urls.length)];
        window.location.href = target;
      } catch {
        /* 数据异常时静默忽略 */
      }
    });
  }

  // 运行天数（与左栏运行时长同一起点）
  function initUptimeDays() {
    const el = document.getElementById('uptime-days');
    if (!el) return;
    const LAUNCH = new Date('2025-12-16T20:14:57+08:00').getTime();
    const days = Math.floor(Math.max(0, Date.now() - LAUNCH) / 86400000);
    el.textContent = `${days} 天`;
  }

  initRandomPost();
  initUptimeDays();
</script>
