---
interface Tag {
  tag: string;
  count: number;
  hasPublished: boolean;
}

interface Props {
  tags: Tag[];
}

const { tags } = Astro.props;
---

<div class="tags-section">
  <div class="sidebar-title">标签</div>
  <div class="tags-box">
    <button class="tag-btn active" data-tag="">全部</button>
    {tags.map(({ tag, count, hasPublished }) => (
      <button 
        class="tag-btn" 
        data-tag={tag}
        data-has-published={String(hasPublished)}
        title={`${count} posts`}
      >
        {tag}
      </button>
    ))}
  </div>
</div>

<style>
  /* 侧栏节标题：overline + 前置纯色短杠 */
  .sidebar-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    padding-left: 0.5rem;
  }

  .sidebar-title::before {
    content: '';
    width: 16px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    opacity: 0.85;
    flex-shrink: 0;
  }

  .tags-box {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-content: flex-start;
    align-items: center;
    padding-right: 0.5rem;
    max-height: 500px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .tags-box::-webkit-scrollbar {
    width: 4px;
  }
  .tags-box::-webkit-scrollbar-track {
    background: transparent;
  }
  .tags-box::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 20px;
  }

  /* 标签 pill：次级底 + 次级文字；hover 主题浅底 */
  .tag-btn {
    padding: 0.5rem 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-secondary);
    color: var(--color-text-light);
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    line-height: 1;
    font-size: 0.85rem;
    font-family: inherit;

    /* Fixed width behavior: 2 per line */
    width: calc(50% - 0.25rem);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }
  .tag-btn:hover {
    background-color: color-mix(in srgb, var(--radial-c1), transparent 90%);
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--radial-c1), transparent 70%);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);

    /* Expand on hover */
    width: auto;
    min-width: calc(50% - 0.25rem);
    max-width: 100%;
    z-index: 2;
  }
  /* 激活：纯色实底 + 白字 */
  .tag-btn.active {
    background: var(--color-primary);
    color: #ffffff;
    border-color: transparent;
  }
  .tag-btn.active:hover {
    background: color-mix(in srgb, var(--color-primary), black 12%);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-btn {
      transition: none;
    }
  }
</style>
