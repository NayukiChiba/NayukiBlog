---
interface Props {
    title: string;
    date: string;
    desc: string;
    url: string;
    tags?: string[];
    image?: string;
}

// Note: This component does not use Astro.glob. The warning likely comes from the parent page fetching posts.
const {
    title,
    date,
    desc,
    url,
    tags = [],
    image = "/profile.png",
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
});
---

<a href={url} class="post-card group" data-astro-prefetch="hover">
    <!-- 封面缩略图（横版卡左侧） -->
    {image && (
        <div class="post-bg-image">
            <img data-src={image} alt="" aria-hidden="true" />
        </div>
    )}
    <!-- 渐变遮罩层（横版布局下不使用，保留节点） -->
    <div class="post-gradient-overlay"></div>

    <div class="post-content">
        <div class="post-text">
            <div class="post-header">
                <span class="post-date">{formattedDate}</span>
                <h3 class="post-title">{title}</h3>
            </div>
            <p class="post-desc">{desc}</p>
            {
                tags.length > 0 && (
                    <div class="post-tags">
                        {tags.map((tag: string) => (
                            <span class="tag" onclick={`event.stopPropagation();event.preventDefault();window.location='/articles?tag=${encodeURIComponent(tag)}'`}>{tag}</span>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</a>

<style>
    /* 横版文章卡（david03 式）：左缩略图 + 右内容，一行一张 */
    .post-card {
        position: relative;
        display: flex;
        align-items: stretch;
        background: var(--color-card-bg, #fff);
        border: 1px solid var(--color-border, #e6e8ee);
        border-radius: var(--radius-lg, 14px);
        text-decoration: none;
        transition:
            transform 0.25s var(--ease-out, ease),
            border-color 0.25s var(--ease-out, ease),
            box-shadow 0.25s var(--ease-out, ease);
        overflow: hidden;
        isolation: isolate;
        box-shadow: var(--shadow-xs, 0 1px 2px rgba(26, 29, 36, 0.04));
        cursor: pointer;
        /* 固定高度：列表中所有卡片高度统一（标题 1 行 + 简介 2 行 + 标签 1 行） */
        height: 178px;
    }

    .post-card:hover {
        border-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 70%);
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover, 0 14px 32px -14px rgba(26, 29, 36, 0.14));
    }

    /* 封面：左侧固定宽，完整覆盖 */
    .post-bg-image {
        position: relative;
        width: 232px;
        flex-shrink: 0;
        overflow: hidden;
        background: var(--color-bg-secondary, #f2f4f8);
    }

    .post-bg-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        opacity: 0;
        transition: transform 0.45s var(--ease-out, ease), opacity 0.4s ease;
    }

    /* 图片加载完成后淡入 */
    .post-bg-image img.loaded {
        opacity: 1;
    }

    .post-card:hover .post-bg-image img {
        transform: scale(1.045);
    }

    /* 旧版渐变遮罩层：不再使用 */
    .post-gradient-overlay {
        display: none;
    }

    /* Content Styles */
    .post-content {
        padding: 1.05rem 1.35rem 1.1rem;
        display: flex;
        flex: 1;
        min-width: 0;
    }

    .post-text {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .post-header {
        margin-bottom: 0.45rem;
    }

    .post-date {
        display: block;
        font-size: 0.75rem;
        color: var(--color-text-muted, #9096a5);
        margin-bottom: 0.35rem;
        font-weight: 500;
        letter-spacing: 0.02em;
    }

    .post-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 650;
        color: var(--color-text, #1a1d24);
        line-height: 1.45;
        letter-spacing: 0.005em;
        transition: color 0.2s ease;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-card:hover .post-title {
        color: var(--color-primary, #4c5670);
    }

    .post-desc {
        margin: 0 0 0.8rem 0;
        color: var(--color-text-light, #4b5162);
        font-size: 0.855rem;
        line-height: 1.65;
        letter-spacing: 0.01em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* 标签固定单行，超出裁剪，避免撑高卡片 */
    .post-tags {
        display: flex;
        gap: 0.45rem;
        flex-wrap: nowrap;
        overflow: hidden;
        margin-top: auto;
    }

    .post-tags .tag {
        flex-shrink: 0;
    }

    .tag {
        font-size: 0.72rem;
        color: var(--color-text-light, #4b5162);
        background: var(--color-bg-secondary, #f2f4f8);
        padding: 0.18rem 0.6rem;
        border-radius: 99px;
        transition: background-color 0.2s ease, color 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .tag:hover {
        background: var(--color-primary-subtle, rgba(76, 86, 112, 0.07));
        color: var(--color-primary, #4c5670);
        border-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 75%);
    }

    /* 窄屏：改竖版（封面顶置，完整比例展示），高度随内容 */
    @media (max-width: 639px) {
        .post-card {
            flex-direction: column;
            height: auto;
        }

        .post-bg-image {
            width: 100%;
            aspect-ratio: 16 / 9;
        }

        .post-content {
            padding: 0.95rem 1.1rem 1.05rem;
        }
    }

    /* 减少动画偏好 */
    @media (prefers-reduced-motion: reduce) {
        .post-card,
        .post-bg-image img {
            transition: none;
        }
    }
</style>
