---
interface Props {
    id: string | number;
    task: string;
    completed: boolean;
    priority: string;
    progress: number;
    icon: string;
}

const { id, task, completed, priority, progress, icon } = Astro.props;

const priorityColors: Record<string, { bg: string; text: string }> = {
    high: { bg: "#fff1f0", text: "#ff4d4f" },
    medium: { bg: "#fffbe6", text: "#faad14" },
    low: { bg: "#f6ffed", text: "#52c41a" },
};

const colors = priorityColors[priority.toLowerCase()] || {
    bg: "#f5f5f5",
    text: "#888",
};
---

<div
    class="task-card"
    data-id={id}
    data-completed={completed.toString()}
    data-progress={progress}
>
    <div class="card-top">
        <span class="icon">
            {
                icon.startsWith("<svg") ? (
                    <Fragment set:html={icon} />
                ) : icon.startsWith("http") || icon.startsWith("/") ? (
                    <img src={icon} alt="icon" class="task-icon-img" />
                ) : (
                    <i class={`${icon}`} />
                )
            }
        </span>
        <span
            class="priority-text"
            style={`background-color: ${colors.bg}; color: ${colors.text}; border-color: ${colors.bg}`}
        >
            {priority}
        </span>
    </div>

    <div class="card-content">
        <h3 class="task-title">{task}</h3>
    </div>

    <div class="card-bottom">
        <div class="progress-wrapper">
            <div class="progress-track">
                <div class="progress-fill" style={`width: ${progress}%`}></div>
            </div>
            <span class="progress-text">{progress}%</span>
        </div>

        <button class="action-btn complete-btn" aria-label="Complete task"
            >✓</button
        >
    </div>
</div>

<style>
    .task-card {
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: var(--shadow-xs);
        transition:
            transform 0.25s var(--ease-out),
            border-color 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out);
        position: relative;
        overflow: hidden;
    }

    .task-card:hover {
        border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
    }

    .task-card[data-completed="true"] {
        opacity: 0.6;
        background: var(--color-bg);
    }

    .task-card[data-completed="true"] .task-title {
        text-decoration: line-through;
        color: var(--color-text-muted);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    /* 图标容器：几何圆角方形；卡片 hover 时主题浅底 + 弹性微转 */
    .icon {
        width: 40px;
        height: 40px;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg-secondary);
        border-radius: var(--radius-md);
        flex-shrink: 0;
        transition:
            background-color 0.25s var(--ease-out),
            transform 0.35s var(--ease-spring);
    }

    .task-card:hover .icon {
        background: color-mix(in srgb, var(--radial-c1), transparent 90%);
        transform: rotate(-4deg) scale(1.05);
    }

    .icon :global(svg) {
        width: 24px;
        height: 24px;
    }

    .task-icon-img {
        width: 24px;
        height: 24px;
        object-fit: contain;
    }

    /* 优先级徽标：胶囊（配色由模板内联样式提供） */
    .priority-text {
        font-size: 0.72rem;
        color: var(--color-text-muted);
        font-weight: 600;
        letter-spacing: 0.02em;
        border: 1px solid transparent;
        padding: 0.2rem 0.6rem;
        border-radius: var(--radius-full);
        background: var(--color-bg-secondary);
    }

    .task-title {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
        line-height: 1.4;
        color: var(--color-text);
    }

    .card-bottom {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: auto;
    }

    .progress-wrapper {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .progress-track {
        flex: 1;
        height: 6px;
        background: var(--color-bg-secondary);
        border-radius: var(--radius-full);
        overflow: hidden;
    }

    /* 进度条：纯色填充 */
    .progress-fill {
        height: 100%;
        background: var(--color-primary);
        border-radius: var(--radius-full);
        transition: width 0.35s var(--ease-out);
    }

    .progress-text {
        font-size: 0.72rem;
        color: var(--color-text-muted);
        font-variant-numeric: tabular-nums;
        width: 2.5em;
        text-align: right;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--color-border);
        background: var(--color-card-bg);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: var(--color-text-light);
        transition:
            background-color 0.2s var(--ease-out),
            color 0.2s var(--ease-out),
            border-color 0.2s var(--ease-out),
            transform 0.2s var(--ease-out);
        padding: 0;
    }

    .action-btn:hover {
        background: color-mix(in srgb, var(--radial-c1), transparent 90%);
        color: var(--color-primary);
        border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
    }

    /* 完成按钮：纯色实底 */
    .complete-btn {
        background: var(--color-primary);
        color: #ffffff;
        border-color: transparent;
        display: none;
        font-size: 0.9rem;
    }

    .complete-btn:hover {
        background: color-mix(in srgb, var(--color-primary), black 12%);
        color: #ffffff;
        border-color: transparent;
        transform: translateY(-1px);
    }

    @media (prefers-reduced-motion: reduce) {
        .task-card,
        .icon,
        .progress-fill,
        .action-btn {
            transition: none;
        }
    }
</style>

<script>
    function initTaskCards() {
        const cards = document.querySelectorAll(".task-card");

        cards.forEach((card) => {
            const completeBtn = card.querySelector(
                ".complete-btn",
            ) as HTMLElement;
            const progressBar = card.querySelector(
                ".progress-fill",
            ) as HTMLElement;
            const progressText = card.querySelector(
                ".progress-text",
            ) as HTMLElement;

            let progress = parseInt(card.getAttribute("data-progress") || "0");
            let isCompleted = card.getAttribute("data-completed") === "true";

            const updateUI = () => {
                progressBar.style.width = `${progress}%`;
                progressText.textContent = `${progress}%`;

                if (progress >= 100 && !isCompleted) {
                    completeBtn.style.display = "flex";
                } else if (isCompleted) {
                    completeBtn.style.display = "none";
                } else {
                    completeBtn.style.display = "none";
                }
            };

            // Initial state
            updateUI();

            completeBtn?.addEventListener("click", () => {
                isCompleted = true;
                card.setAttribute("data-completed", "true");
                updateUI();
            });
        });
    }

    // Run on load
    initTaskCards();

    // Re-run on view transitions if enabled
    document.addEventListener("astro:page-load", initTaskCards);
</script>
