---
interface Props {
  title: string;
  desc: string;
  url: string;
  tech?: string[];
}

const { title, desc, url, tech = [] } = Astro.props;
---

<div class="project-card">
  <div class="project-content">
    <div class="project-header">
      <h3 class="project-title">
        <span class="card-link">{title}</span>
      </h3>
      <!-- GitHub Icon -->
      <a href={url} target="_blank" class="icon-link" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
      </a>
    </div>
    <p class="project-desc">{desc}</p>
    
    {tech.length > 0 && (
      <div class="project-tags">
        {tech.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-xs);
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
    height: 100%;
    box-sizing: border-box;
    /* 去掉 overflow:hidden，避免 hover 上移时顶部被裁剪 */
    overflow: visible;
    z-index: 1;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
    z-index: 10;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.125rem;
  }

  .project-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    transition: color 0.2s var(--ease-out);
    letter-spacing: -0.01em;
  }

  /* hover 标题变主题色 */
  .project-card:hover .project-title {
    color: var(--color-primary);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .project-desc {
    margin: 0 0 1.5rem 0;
    color: var(--color-text-light);
    font-size: 0.9375rem;
    line-height: 1.7;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: auto;
  }

  /* 标签 pill：次级底 + 次级文字；hover 主题浅底 */
  .tag {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    background: var(--color-bg-secondary);
    color: var(--color-text-light);
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
    border: 1px solid transparent;
  }

  /* 第一个标签：主题浅底突出主技术栈 */
  .tag:first-child {
    background: color-mix(in srgb, var(--radial-c1), transparent 90%);
    color: var(--color-primary);
  }

  .tag:hover {
    background: color-mix(in srgb, var(--radial-c1), transparent 90%);
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--radial-c1), transparent 70%);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  /* 图标容器：几何圆角方形；hover 主题浅底 + 弹性微转 */
  .icon-link {
    color: var(--color-text-light);
    transition:
      color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.35s var(--ease-spring);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    border: 1px solid transparent;
  }

  .icon-link:hover {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--radial-c1), transparent 90%);
    border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
    transform: translateY(-2px) rotate(6deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-title,
    .tag,
    .icon-link {
      transition: none;
    }
  }
</style>
