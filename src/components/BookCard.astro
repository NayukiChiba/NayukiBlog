---
interface Props {
    title: string;
    cover: string;
    url?: string;
    tags?: string[];
}

const { title, cover, url, tags = [] } = Astro.props;
---

<div class="book-card">
    <div class="cover-wrapper">
        <img src={cover} alt={title} loading="lazy" />
    </div>
    <div class="book-info">
        <h3 class="book-title">{title}</h3>

        {
            tags.length > 0 && (
                <div class="book-tags">
                    {tags.map((tag) => (
                        <span class="tag">{tag}</span>
                    ))}
                </div>
            )
        }

        {
            url ? (
                <a
                    href={url}
                    class="link-btn"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                    下载链接
                </a>
            ) : (
                <span class="link-btn disabled" title="暂无链接">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                    暂无链接
                </span>
            )
        }
    </div>
</div>

<style>
    .book-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition:
            transform 0.3s var(--ease-out),
            border-color 0.3s var(--ease-out),
            box-shadow 0.3s var(--ease-out);
        height: 100%;
        box-shadow: var(--shadow-xs);
    }

    .book-card:hover {
        border-color: color-mix(in srgb, var(--color-primary), transparent 70%);
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
    }

    .cover-wrapper {
        width: 100%;
        aspect-ratio: 8/9;
        overflow: hidden;
        background: var(--color-bg-secondary);
        border-bottom: 1px solid var(--color-border-light);
        position: relative;
    }

    .cover-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s var(--ease-out);
    }

    .book-card:hover .cover-wrapper img {
        transform: scale(1.05);
    }

    .book-info {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 0.75rem;
    }

    .book-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.2s var(--ease-out);
    }

    .book-card:hover .book-title {
        color: var(--color-primary);
    }

    .book-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    /* 标签 pill：次级底 + muted 文字；hover 主题浅底 */
    .tag {
        font-size: 0.7rem;
        color: var(--color-text-muted);
        background: var(--color-bg-secondary);
        padding: 0.25rem 0.6rem;
        border-radius: var(--radius-full);
        border: 1px solid transparent;
        font-weight: 500;
        transition:
            background-color 0.2s var(--ease-out),
            color 0.2s var(--ease-out);
    }

    .tag:hover {
        background: color-mix(in srgb, var(--radial-c1), transparent 90%);
        color: var(--color-primary);
    }

    /* 主按钮：纯色胶囊 */
    .link-btn {
        margin-top: auto;
        width: 100%;
        padding: 0.7rem;
        border: none;
        border-radius: var(--radius-full);
        background: var(--color-primary);
        color: #ffffff;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        box-shadow: var(--shadow-xs);
        transition:
            transform 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out),
            background-color 0.25s var(--ease-out);
        text-decoration: none;
    }

    .link-btn:hover:not(.disabled) {
        color: #ffffff;
        transform: translateY(-1px);
        background: color-mix(in srgb, var(--color-primary), black 12%);
        box-shadow: var(--shadow-sm);
    }

    .link-btn.disabled {
        background: var(--color-bg-secondary);
        color: var(--color-text-muted);
        cursor: not-allowed;
        border: 1px solid var(--color-border);
        box-shadow: none;
    }

    .link-btn svg {
        width: 16px;
        height: 16px;
    }

    @media (prefers-reduced-motion: reduce) {
        .book-card,
        .cover-wrapper img,
        .book-title,
        .tag,
        .link-btn {
            transition: none;
        }
    }
</style>
