---
// 左侧信息栏 — david03 式单张通栏卡
// 头像资料区 + 「导航」分组菜单 + 底部站点状态；随页面滚动（外层 aside 控制 sticky）

const navItems = [
  { href: '/home', label: '首页', icon: 'home' },
  { href: '/articles', label: '文章', icon: 'article' },
  { href: '/projects', label: '项目', icon: 'project' },
  { href: '/diary', label: '日记', icon: 'diary' },
  { href: '/library', label: '书架', icon: 'book' },
  { href: '/gallery', label: '相册', icon: 'image' },
  { href: '/todo', label: '待办', icon: 'check' },
  { href: '/toolbox', label: '工具箱', icon: 'tool' },
  { href: '/rss', label: '订阅', icon: 'rss' },
  { href: '/about', label: '关于', icon: 'user' },
];

// 归一化路径：静态构建（directory 格式）时 pathname 带尾斜杠，
// 去掉尾斜杠再比较，保证 dev 与部署后 active 高亮一致
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<div class="aside-card side-panel">
  <!-- 资料区 -->
  <div class="panel-profile">
    <img
      src="/profile.png"
      alt="卟瓿钚"
      class="aside-avatar"
      onerror="this.src='https://ui-avatars.com/api/?name=Nayuki&background=4c5670&color=fff'"
    />
    <span class="aside-name">卟瓿钚</span>
    <span class="aside-bio">记录，思考，然后继续前行。</span>
    <div class="aside-links">
      <a href="https://github.com/NayukiChiba" target="_blank" rel="noopener" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
      </a>
      <a href="https://x.com/NayeyChiba" target="_blank" rel="noopener" aria-label="Twitter">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
      </a>
      <a href="mailto:MekoNayuki@gmail.com" aria-label="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
      </a>
    </div>
  </div>

  <div class="panel-divider" aria-hidden="true"></div>

  <!-- 导航分组 -->
  <nav class="panel-nav" aria-label="站点导航">
    <span class="group-label">导航</span>
    <ul class="aside-nav-list">
      {navItems.map(item => (
        <li>
          <a href={item.href} class={currentPath === item.href ? 'active' : ''}>
            <span class="nav-icon" aria-hidden="true">
              {item.icon === 'home' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              )}
              {item.icon === 'article' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
              )}
              {item.icon === 'project' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
              )}
              {item.icon === 'diary' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              )}
              {item.icon === 'book' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              )}
              {item.icon === 'image' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              )}
              {item.icon === 'check' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              )}
              {item.icon === 'tool' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
              )}
              {item.icon === 'rss' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
              )}
              {item.icon === 'user' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              )}
            </span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="panel-divider" aria-hidden="true"></div>

  <!-- 站点状态 -->
  <div class="panel-status">
    <div class="status-row">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span class="status-label">已运行</span>
      <span class="status-value" id="site-uptime">—</span>
    </div>
  </div>
</div>

<style>
  /* 单张通栏卡 */
  .side-panel {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }

  .panel-divider {
    height: 1px;
    background: var(--color-border-light);
    margin: 0 1rem;
  }

  /* ===== 资料区 ===== */
  .panel-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.45rem;
    padding: 1.75rem 1.25rem 1.35rem;
  }

  .aside-avatar {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #ffffff;
    outline: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: transform 0.5s var(--ease-spring, ease);
  }

  .panel-profile:hover .aside-avatar {
    transform: rotate(360deg);
  }

  .aside-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.4rem;
  }

  .aside-bio {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .aside-links {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .aside-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s var(--ease-out, ease);
  }

  .aside-links a:hover {
    color: var(--color-primary);
    background: var(--color-primary-subtle);
    transform: translateY(-2px);
  }

  /* ===== 导航分组 ===== */
  .panel-nav {
    padding: 0.875rem 0.7rem 1rem;
  }

  .group-label {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    padding: 0 0.65rem 0.5rem;
  }

  .aside-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .aside-nav-list a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-light);
    text-decoration: none;
    border-radius: 9px;
    transition:
      color 0.2s var(--ease-out, ease),
      background-color 0.2s var(--ease-out, ease),
      padding-left 0.2s var(--ease-out, ease);
  }

  .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
    flex-shrink: 0;
  }

  .aside-nav-list a:not(.active):hover {
    color: var(--color-text);
    background: var(--color-bg-secondary);
    padding-left: 0.85rem;
  }

  .aside-nav-list a:hover .nav-icon {
    color: var(--color-primary);
  }

  .aside-nav-list a.active {
    color: var(--color-text);
    font-weight: 600;
    background: var(--color-primary-subtle);
  }

  .aside-nav-list a.active .nav-icon {
    color: var(--color-primary);
  }

  .aside-nav-list a.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 52%;
    border-radius: 999px;
    background: var(--color-primary);
  }

  /* ===== 站点状态 ===== */
  .panel-status {
    padding: 0.8rem 1.1rem;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .status-row svg {
    color: var(--color-primary);
    opacity: 0.75;
    flex-shrink: 0;
  }

  .status-label {
    flex-shrink: 0;
  }

  .status-value {
    margin-left: auto;
    color: var(--color-text-light);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .aside-avatar,
    .aside-links a,
    .aside-nav-list a {
      transition: none;
    }
  }
</style>

<script>
  // 站点运行时长（建站于 2025-12-16，随仓库首次提交）
  function initSiteUptime() {
    const el = document.getElementById('site-uptime');
    if (!el) return;

    const LAUNCH = new Date('2025-12-16T20:14:57+08:00').getTime();

    function render() {
      const diff = Math.max(0, Date.now() - LAUNCH);
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const mins = Math.floor((diff % 3600000) / 60000);
      el!.textContent = `${days} 天 ${hours} 时 ${mins} 分`;
    }

    render();
    // 每分钟刷新一次即可
    setInterval(render, 60000);
  }

  initSiteUptime();
</script>
