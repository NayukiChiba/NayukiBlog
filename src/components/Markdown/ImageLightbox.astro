---
// 图片预览灯箱组件
---

<div id="image-lightbox" class="lightbox">
    <div class="lightbox-overlay"></div>
    <div class="lightbox-content">
        <button class="lightbox-close" aria-label="关闭">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <img id="lightbox-image" src="" alt="" />
    </div>
</div>

<script is:inline>
    function initImageLightbox() {
        var lightbox = document.getElementById("image-lightbox");
        var lightboxImg = document.getElementById("lightbox-image");
        var lightboxClose = document.querySelector(".lightbox-close");
        var lightboxOverlay = document.querySelector(".lightbox-overlay");
        var contentImages = document.querySelectorAll(".content img");

        contentImages.forEach(function (img) {
            img.style.cursor = "pointer";
            img.addEventListener("click", function () {
                if (lightbox && lightboxImg) {
                    lightboxImg.src = img.src;
                    lightboxImg.alt = img.alt;
                    lightbox.classList.add("active");
                    document.body.style.overflow = "hidden";
                }
            });
        });

        function closeLightbox() {
            if (lightbox) {
                lightbox.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        if (lightboxClose)
            lightboxClose.addEventListener("click", closeLightbox);
        if (lightboxOverlay)
            lightboxOverlay.addEventListener("click", closeLightbox);

        document.addEventListener("keydown", function (e) {
            if (
                e.key === "Escape" &&
                lightbox &&
                lightbox.classList.contains("active")
            ) {
                closeLightbox();
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initImageLightbox);
</script>

<style is:global>
    .lightbox {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s var(--ease-out, ease), visibility 0.3s var(--ease-out, ease);
    }

    .lightbox.active {
        opacity: 1;
        visibility: visible;
    }

    /* 遮罩：深色冷调 + 玻璃模糊 */
    .lightbox-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 17, 28, 0.72);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        cursor: pointer;
    }

    /* 内容：入场轻缩放；尺寸统一约束，避免不同图片忽大忽小 */
    .lightbox-content {
        position: relative;
        z-index: 10000;
        max-width: min(1040px, 92vw);
        max-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: scale(0.96);
        transition: transform 0.3s var(--ease-out, ease);
    }

    .lightbox.active .lightbox-content {
        transform: scale(1);
    }

    /* 图片（含 GIF）：统一舞台 —— 高度不超过 80vh、宽度不超过 1040px，
       等比缩放完整展示；小图不放大（width/height auto） */
    .lightbox-content img {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 80vh;
        object-fit: contain;
        border-radius: var(--radius-md, 12px);
        background: rgba(255, 255, 255, 0.04);
        box-shadow: 0 24px 80px rgba(15, 17, 28, 0.5);
    }

    /* 关闭按钮：玻璃白圆钮，hover 旋转（呼应导航关闭钮） */
    .lightbox-close {
        position: absolute;
        top: -3rem;
        right: 0;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text, #14161f);
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            transform 0.3s var(--ease-out, ease);
        z-index: 10001;
    }

    .lightbox-close:hover {
        background: #ffffff;
        color: var(--color-primary, #4c5670);
        transform: rotate(90deg);
    }

    .lightbox-close svg {
        color: inherit;
    }

    /* 移动端：更大可视范围 + 关闭钮收进屏幕角落 */
    @media (max-width: 768px) {
        .lightbox-content {
            max-width: 94vw;
            max-height: 76vh;
        }

        .lightbox-content img {
            max-height: 76vh;
            border-radius: var(--radius-sm, 8px);
        }

        .lightbox-close {
            position: fixed;
            top: max(1rem, env(safe-area-inset-top));
            right: 1rem;
        }
    }

    /* 减弱动效偏好：取消缩放与旋转 */
    @media (prefers-reduced-motion: reduce) {
        .lightbox,
        .lightbox-content,
        .lightbox-close {
            transition: none;
        }
        .lightbox-content {
            transform: none;
        }
        .lightbox-close:hover {
            transform: none;
        }
    }
</style>
