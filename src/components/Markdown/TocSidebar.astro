---
// TocSidebar.astro - 桌面端目录侧边栏组件
import ArticleContentSearch from "./ArticleContentSearch.astro";
---

<aside class="toc-sidebar desktop-only">
    <div class="toc-sticky">
        <ArticleContentSearch />
        <div class="toc-header" id="toc-header-clickable">
            <span>文章目录</span>
            <span class="toc-header-actions">
                <button
                    id="toc-scroll-top"
                    class="toc-top-btn"
                    aria-label="回到顶部"
                    title="回到顶部"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><line x1="12" y1="19" x2="12" y2="5"></line><polyline
                            points="5 12 12 5 19 12"></polyline></svg
                    >
                </button>
                <button
                    id="toc-toggle"
                    class="toc-toggle"
                    aria-label="Toggle Table of Contents"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><polyline points="6 9 12 15 18 9"></polyline></svg
                    >
                </button>
            </span>
        </div>
        <nav id="article-toc"></nav>
    </div>
</aside>

<style is:global>
    /* 桌面端/移动端显示控制 */
    .desktop-only {
        display: none;
    }

    @media (min-width: 1480px) {
        .desktop-only {
            display: block;
        }
    }

    /* 侧边栏样式 - 固定定位（fixed），滚动时纹丝不动，便于随时定位
       水平位置与 .post-shell 三栏 grid 的右栏对齐（与左侧信息栏等宽、沿中线对称） */
    .toc-sidebar {
        position: fixed;
        top: 28px;
        right: calc((100vw - var(--page-max, min(1400px, 92vw))) / 2);
        width: var(--aside-col, 252px);
        max-height: calc(100vh - 56px);
        overflow: hidden;
        z-index: 50;
    }

    .toc-sidebar::-webkit-scrollbar {
        width: 4px;
    }
    .toc-sidebar::-webkit-scrollbar-thumb {
        background-color: #e3e6f0;
        border-radius: 4px;
    }
    .toc-sidebar:hover::-webkit-scrollbar-thumb {
        background-color: #d4d8e6;
    }

    /* 玻璃白卡容器 */
    .toc-sticky {
        width: 100%;
        max-height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: var(--surface-glass, rgba(255, 255, 255, 0.72));
        backdrop-filter: blur(16px) saturate(1.5);
        -webkit-backdrop-filter: blur(16px) saturate(1.5);
        border: 1px solid var(--color-border-light, #edeff7);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-sm, 0 2px 8px -2px rgba(23, 25, 35, 0.06));
        padding: 0.875rem 0.625rem 0.625rem;
    }

    .toc-header {
        font-family: var(--font-display, inherit);
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-size: 1rem;
        color: var(--color-text, #14161f);
        letter-spacing: 0;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

    .toc-header > span:first-child {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* 标题前置几何标记：纯色旋转小方块（呼应 Logo） */
    .toc-header > span:first-child::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 2.5px;
        transform: rotate(45deg);
        background: var(--color-primary, #4c5670);
        flex-shrink: 0;
    }

    /* 头部右侧操作区：回到顶部 + 收缩箭头 */
    .toc-header-actions {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .toc-top-btn {
        background: none;
        border: none;
        color: var(--color-text-muted, #8b91a5);
        cursor: pointer;
        padding: 3px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .toc-top-btn:hover {
        color: var(--color-primary, #4c5670);
        background-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 90%);
    }

    .toc-toggle {
        background: none;
        border: none;
        color: var(--color-text-muted, #8b91a5);
        cursor: pointer;
        padding: 3px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: transform 0.3s var(--ease-out, ease), background-color 0.2s ease, color 0.2s ease;
    }

    .toc-toggle:hover {
        color: var(--color-primary, #4c5670);
        background-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 90%);
    }

    .toc-toggle.collapsed {
        transform: rotate(-90deg);
    }

    #article-toc {
        transition:
            max-height 0.3s ease,
            opacity 0.3s ease;
        max-height: calc(100vh - 250px);
        flex: 1;
        min-height: 0;
        opacity: 1;
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
    }

    #article-toc.collapsed {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
    }

    /* 目录滚动条美化 */
    #article-toc::-webkit-scrollbar {
        width: 4px;
    }
    #article-toc::-webkit-scrollbar-thumb {
        background-color: transparent;
        border-radius: 4px;
    }
    #article-toc:hover::-webkit-scrollbar-thumb {
        background-color: #d4d8e6;
    }

    #article-toc ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    #article-toc li {
        margin: 0;
        line-height: 1;
    }

    /* 目录项：左侧纯色短条（hover/active 展开）+ 平滑位移 */
    #article-toc a {
        text-decoration: none;
        color: var(--color-text-light, #4e5567);
        font-size: 0.9rem;
        transition:
            color 0.2s var(--ease-out, ease),
            background-color 0.2s var(--ease-out, ease),
            transform 0.25s var(--ease-out, ease);
        display: block;
        position: relative;
        padding: 0.6rem 0.8rem 0.6rem 1rem;
        line-height: 1.5;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
        min-width: 0;
        border-radius: var(--radius-sm, 8px);
    }

    /* 左侧纯色指示条 */
    #article-toc a::before {
        content: "";
        position: absolute;
        left: 2px;
        top: 50%;
        transform: translateY(-50%) scaleY(0);
        width: 3px;
        height: 58%;
        border-radius: var(--radius-full, 999px);
        background: var(--color-primary, #4c5670);
        transition: transform 0.25s var(--ease-out, ease);
    }

    /* 大纲中的 KaTeX 公式：跟随目录字号，不放大 */
    #article-toc a .katex {
        font-size: 1em;
    }

    #article-toc a:hover {
        color: var(--color-primary, #4c5670);
        background-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 93%);
        transform: translateX(3px);
    }

    #article-toc a.active {
        color: var(--color-primary, #4c5670);
        font-weight: 600;
        background-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 91%);
    }

    #article-toc a:hover::before,
    #article-toc a.active::before {
        transform: translateY(-50%) scaleY(1);
    }

    /* TOC 容器布局 */
    .toc-item-container {
        position: relative;
        display: flex;
        align-items: center;
    }

    /* 折叠按钮样式 — 明显的可点击箭头 */
    .toc-collapse-btn {
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--color-text-muted, #8b91a5);
        border-radius: 6px;
        transition: transform 0.2s var(--ease-out, ease), background-color 0.2s ease, color 0.2s ease;
        z-index: 2;
        margin-left: auto;
        margin-right: 0.25rem;
        flex-shrink: 0;
    }

    .toc-collapse-btn:hover {
        color: var(--color-primary, #4c5670);
        background-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 90%);
    }

    .toc-collapse-btn.collapsed {
        transform: rotate(-90deg);
    }

    /* 隐藏状态 */
    .toc-item.hidden-by-parent {
        display: none;
    }

    /* 目录层级：层级关系由 JS 注入的树形连接线前缀表示，缩进统一 */
    .toc-item.level-0 {
        margin-top: 0.25rem;
    }
    #article-toc .toc-item.level-0 a {
        font-weight: 600;
    }

    .toc-item.level-1 {
        margin-top: 0.15rem;
    }
    .toc-item.level-2 {
        margin-top: 0.15rem;
    }
    .toc-item.level-3 {
        margin-top: 0.1rem;
    }

    #article-toc .toc-item a {
        padding-left: 0.5rem;
    }

    /* 树形连接线前缀：等宽字体保证竖线与连接符纵向对齐 */
    #article-toc .toc-tree-prefix {
        color: rgba(139, 145, 165, 0.45);
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        white-space: pre;
        font-size: 0.9em;
    }

    /* 悬停/高亮时连接线跟随主题色 */
    #article-toc .toc-item a:hover .toc-tree-prefix,
    #article-toc .toc-item a.active .toc-tree-prefix {
        color: var(--color-primary, #4c5670);
    }

    /* 层级分隔线：每个顶级标题（除第一个）上方都有分隔线 */
    #article-toc .toc-item.level-0:not(:first-child) {
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid var(--color-border-light, #edeff7);
    }

    /* 减弱动效偏好：取消目录位移与旋转过渡 */
    @media (prefers-reduced-motion: reduce) {
        #article-toc a,
        #article-toc a::before,
        .toc-toggle,
        .toc-top-btn,
        .toc-collapse-btn {
            transition: none;
        }
        #article-toc a:hover {
            transform: none;
        }
    }
</style>
