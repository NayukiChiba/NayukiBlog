---
// CopyToast - 复制成功提示组件
---

<div id="copy-toast" class="toast">
    <span class="dot"></span>
    <span class="message">已复制到剪贴板</span>
</div>

<style>
    /* Toast：深色玻璃圆角 pill + 成功绿点
       注意：显隐有两条路径（.show 类 / JS 行内 opacity+transform），
       基态必须保持 left:50% + translateX(-50%) 定位 */
    .toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: rgba(20, 22, 31, 0.82);
        backdrop-filter: blur(12px) saturate(1.4);
        -webkit-backdrop-filter: blur(12px) saturate(1.4);
        color: #f4f5fa;
        padding: 0.7rem 1.375rem;
        border-radius: var(--radius-full, 999px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: var(--shadow-lg, 0 16px 40px -16px rgba(23, 25, 35, 0.16));
        display: flex;
        align-items: center;
        gap: 0.7rem;
        z-index: 1000;
        transition:
            opacity 0.3s var(--ease-out, ease),
            transform 0.3s var(--ease-out, ease);
        opacity: 0;
        pointer-events: none;
    }

    .toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    /* 成功绿点（语义绿，低饱和）+ 呼吸光环 */
    .toast .dot {
        width: 8px;
        height: 8px;
        background-color: var(--color-accent-green, #5f9e7f);
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgba(95, 158, 127, 0.25);
        position: relative;
        flex-shrink: 0;
    }

    .toast.show .dot {
        animation: toastPulse 1.6s ease-out infinite;
    }

    @keyframes toastPulse {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(95, 158, 127, 0.45);
        }
        70% {
            box-shadow: 0 0 0 6px rgba(95, 158, 127, 0);
        }
    }

    .toast .message {
        font-size: 0.9rem;
        font-weight: 500;
        color: inherit;
    }

    /* 减弱动效偏好 / 全局动画开关：关闭过渡与循环脉冲 */
    @media (prefers-reduced-motion: reduce) {
        .toast {
            transition: none;
        }
        .toast.show .dot {
            animation: none;
        }
    }

    :global(html.fx-anim-off) .toast {
        transition: none;
    }

    :global(html.fx-anim-off) .toast.show .dot {
        animation: none;
    }
</style>

<script is:inline>
    const toast = document.getElementById("copy-toast");
    var timeout;

    function showToast() {
        if (!toast) return;
        toast.classList.add("show");
        if (timeout) clearTimeout(timeout);
        timeout = setTimeout(() => {
            toast.classList.remove("show");
        }, 2000);
    }

    // 挂载到 window 对象供其他脚本调用
    window.showCopyToast = showToast;
</script>
