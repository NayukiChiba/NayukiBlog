---
interface Props {
  title: string;
  formattedDate: string;
  description?: string;
  tags?: string[];
  image?: string;
}

const { title, formattedDate, description, tags, image } = Astro.props;
---

<header class="post-header">
  {
    image && (
      <div class="cover-image-wrapper">
        <img src={image} alt={title} class="cover-image" />
      </div>
    )
  }
  <div class="meta">
    <span class="date">{formattedDate}</span>
  </div>
  <h1 class="page-title">{title}</h1>
  {
    description && (
      <div class="description-card">
        <span class="description-label">简介</span>
        <div class="description-content" data-text={description} />
      </div>
    )
  }
  {
    tags && (
      <div class="tags">
        {tags.map((tag: string) => {
          const cleanTag = String(tag).replace(/[\[\]"']/g, "");
          return <a href={`/articles?tag=${encodeURIComponent(cleanTag)}`} class="tag">{cleanTag}</a>;
        })}
      </div>
    )
  }
</header>

<style is:global>
  .post-header {
    margin-bottom: 1.5rem;
  }

  /* 封面图：圆角 + 柔和阴影 */
  .cover-image-wrapper {
    margin-bottom: 2rem;
  }

  .cover-image {
    display: block;
    max-width: 60%;
    height: auto;
    margin: 0 auto;
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-md, 0 8px 24px -8px rgba(23, 25, 35, 0.1));
  }

  @media (max-width: 767px) {
    .cover-image {
      max-width: 100%;
    }
  }

  /* 元信息：日期 pill（前置纯色小点），常规字体常规大小写 */
  .meta {
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: center;
  }

  .meta .date {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted, #9096a5);
    font-weight: 500;
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-border-light, #f0f1f5);
    border-radius: var(--radius-full, 999px);
    padding: 0.3rem 0.875rem;
    box-shadow: var(--shadow-xs, 0 1px 2px rgba(26, 29, 36, 0.04));
  }

  .meta .date::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--radial-c2, #93a9c9);
    flex-shrink: 0;
  }

  /* 文章标题：全局 .page-title 提供纯色短杠装饰，加大字号 */
  .post-header .page-title {
    font-size: clamp(1.9rem, 1.35rem + 2.2vw, 2.7rem);
    line-height: 1.2;
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  /* 标签：pill 化，hover 主题浅底 + 轻抬升 */
  .tags {
    margin-top: 1.25rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .post-header .tags a.tag {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-light, #4b5162);
    background-color: var(--color-bg-secondary, #f2f4f8);
    text-decoration: none; /* 覆盖 .content a 的下划线 */
    border-radius: var(--radius-full, 999px);
    transition:
      color 0.2s var(--ease-out, ease),
      background-color 0.2s var(--ease-out, ease),
      transform 0.2s var(--ease-out, ease);
  }

  .post-header .tags a.tag:hover {
    color: var(--color-primary, #4c5670);
    background-color: color-mix(in srgb, var(--color-primary, #4c5670), transparent 90%);
    transform: translateY(-1px);
  }

  /* 简介卡片：浅灰底 + 左侧纯色细条 */
  .description-card {
    position: relative;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem 1rem 1.375rem;
    background-color: var(--color-bg-secondary, #f2f4f8);
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    display: flex;
    align-items: baseline;
    line-height: 1.7;
    text-align: left;
  }

  .description-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-primary, #4c5670);
    opacity: 0.85;
  }

  /* 移除大引号 */
  .description-card::after {
    content: none;
  }

  /* 简介标签：纯色主题文字 */
  .description-label {
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-primary, #4c5670);
    margin-right: 1rem;
    flex-shrink: 0;
  }

  .description-content {
    color: var(--color-text-light, #4b5162);
    font-size: 0.95rem;
    min-width: 0; /* Important for flex child wrapping */
  }

  /* 减弱动效偏好 */
  @media (prefers-reduced-motion: reduce) {
    .post-header .tags a.tag {
      transition: none;
    }
    .post-header .tags a.tag:hover {
      transform: none;
    }
  }
</style>
