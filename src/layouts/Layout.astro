---
import FloatingButton from '../components/FloatingButton.astro';
import SakanaWidgetComponent from '../components/SakanaWidget.astro';
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-cn">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<FloatingButton />
		<SakanaWidgetComponent />
	</body>
</html>
<style is:global>
	:root {
		--accent: 99, 102, 241;
		--accent-light: 34, 211, 238;
		--accent-dark: 70, 73, 200;
		--accent-gradient: linear-gradient(
			135deg,
			rgb(var(--accent)),
			rgb(var(--accent-light))
		);
	}
	html {
		font-family: 'Inter', system-ui, sans-serif;
		background: #f7f8fc;
	}
	code {
		font-family:
			'JetBrains Mono',
			ui-monospace,
			Menlo,
			Monaco,
			Consolas,
			monospace;
	}
</style>
