---
import PageLayout from "../layouts/PageLayout.astro";
import TaskCard from "../components/TaskCard.astro";
import { getTodos } from "../lib/data";

// 从本地 JSON 读取待办事项数据
const todos = getTodos({ status: 'active' });

const completedTodos = todos.filter((t) => t.completed);
const activeTodos = todos.filter((t) => !t.completed);

const shortTerm = activeTodos.filter((t) => t.type === "short-term");
const mediumTerm = activeTodos.filter((t) => t.type === "mid-term");
const longTerm = activeTodos.filter((t) => t.type === "long-term");
---

<PageLayout title="TODO List | Nayuki Blog">
    <div class="container" id="todo-container">
        <div class="header-row">
            <div>
                <h1 class="page-title">任务管理</h1>
                <p class="page-desc">规划与追踪个人目标。</p>
            </div>
        </div>

        <!-- Layer 1: Completed Tasks (Collapsible) -->
        {
            completedTodos.length > 0 && (
                <details class="completed-section">
                    <summary>已完成任务 ({completedTodos.length})</summary>
                    <div class="task-grid mt-4">
                        {completedTodos.map((todo) => (
                            <TaskCard {...todo} />
                        ))}
                    </div>
                </details>
            )
        }

        <div class="todo-layers">
            <!-- Layer 2: Short Term -->
            <section class="layer-section">
                <h2 class="layer-title"><span class="layer-num" aria-hidden="true">01</span> 短期目标 (Short-term)</h2>
                <div class="task-grid">
                    {shortTerm.map((todo) => <TaskCard {...todo} />)}
                </div>
            </section>

            <!-- Layer 3: Medium Term -->
            <section class="layer-section">
                <h2 class="layer-title"><span class="layer-num" aria-hidden="true">02</span> 中期目标 (Medium-term)</h2>
                <div class="task-grid">
                    {mediumTerm.map((todo) => <TaskCard {...todo} />)}
                </div>
            </section>

            <!-- Layer 4: Long Term -->
            <section class="layer-section">
                <h2 class="layer-title"><span class="layer-num" aria-hidden="true">03</span> 长期目标 (Long-term)</h2>
                <div class="task-grid">
                    {longTerm.map((todo) => <TaskCard {...todo} />)}
                </div>
            </section>
        </div>
    </div>
</PageLayout>

<style>
    .container {
        /* 放宽内层容器：外层 main 已限 1220px */
        max-width: 100%;
    }

    .header-row {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .page-desc {
        color: var(--color-text-muted);
        margin: 0;
        text-align: center;
    }

    /* 已完成任务：折叠卡片 */
    .completed-section {
        margin-bottom: 3rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 0.5rem;
        background: var(--color-card-bg);
        box-shadow: var(--shadow-xs);
        transition:
            border-color 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out);
    }

    .completed-section:hover {
        border-color: color-mix(in srgb, var(--radial-c1), transparent 60%);
        box-shadow: var(--shadow-sm);
    }

    .completed-section summary {
        cursor: pointer;
        padding: 0.6rem 0.875rem;
        font-weight: 500;
        color: var(--color-text-light);
        user-select: none;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: var(--radius-md);
        transition:
            color 0.2s var(--ease-out),
            background-color 0.2s var(--ease-out);
    }

    .completed-section summary::-webkit-details-marker {
        display: none;
    }

    /* 展开指示箭头：纯色雾蓝 */
    .completed-section summary::before {
        content: "▶";
        font-size: 0.7em;
        transition: transform 0.25s var(--ease-out);
        color: var(--color-primary);
    }

    .completed-section[open] summary::before {
        transform: rotate(90deg);
    }

    .completed-section summary:hover {
        color: var(--color-text);
        background: color-mix(in srgb, var(--radial-c1), transparent 94%);
    }

    .mt-4 {
        margin-top: 1rem;
    }

    .layer-section {
        margin-bottom: 4rem;
    }

    /* 层级标题：装饰序号 + 纯色短杠 */
    .layer-title {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border-light);
        color: var(--color-text);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        position: relative;
    }

    .layer-title::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 2.5rem;
        height: 3px;
        border-radius: var(--radius-full);
        background: var(--color-primary);
        opacity: 0.85;
    }

    /* 装饰序号：纯色弱化 */
    .layer-num {
        font-family: var(--font-display);
        font-size: 0.9em;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--color-text-muted);
    }

    .task-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 640px) {
        .task-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .task-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* 减动效偏好：关闭过渡 */
    @media (prefers-reduced-motion: reduce) {
        .completed-section,
        .completed-section summary,
        .completed-section summary::before {
            transition: none;
        }
    }
</style>
