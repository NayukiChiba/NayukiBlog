---
// 🚀 静态预渲染
export const prerender = true;

import ParticleBackground from "../components/ParticleBackground.astro";
import ProgressBar from "../components/ProgressBar.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>Loading...</title>
    <style>
      :root {
        --radial-c1: #4c5670;
        --radial-c2: #93a9c9;
      }
      body {
        margin: 0;
        overflow: hidden;
        background: #fafbfd;
        color: #1a1d24;
        font-family:
          'Inter',
          -apple-system,
          'Segoe UI',
          'PingFang SC',
          'Microsoft YaHei',
          system-ui,
          sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        user-select: none;
      }
      .content {
        position: relative;
        z-index: 1;
        text-align: center;
        animation: fadeIn 1.2s cubic-bezier(0.22, 1, 0.36, 1);
      }
      /* 几何标记：墨蓝旋转方块 + 白色圆孔 */
      .mark {
        position: relative;
        width: 38px;
        height: 38px;
        margin: 0 auto 1.75rem;
        border-radius: 11px;
        background: var(--radial-c1);
        transform: rotate(45deg);
        animation: markSpin 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
        box-shadow: 0 10px 26px -8px rgba(76, 86, 112, 0.4);
      }
      .mark::after {
        content: '';
        position: absolute;
        inset: 11.5px;
        border-radius: 50%;
        background: #fafbfd;
      }
      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0 0 0.625rem;
        letter-spacing: 0.08em;
        color: #1a1d24;
      }
      p {
        font-size: 0.95rem;
        color: #9096a5;
        margin: 0;
        letter-spacing: 0.14em;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes markSpin {
        0% { transform: rotate(45deg); }
        50% { transform: rotate(225deg); }
        100% { transform: rotate(405deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        .content { animation: none; }
        .mark { animation: none; }
      }
    </style>
  </head>
  <body>
    <ParticleBackground />
    <ProgressBar />
    <div class="content">
      <div class="mark" aria-hidden="true"></div>
      <h1>NAYUKI BLOG</h1>
      <p>正在前往新世界...</p>
    </div>

    <script is:inline>
      // Redirect after delay
      setTimeout(function () {
        window.location.href = "/home";
      }, 2500);
    </script>
  </body>
</html>
