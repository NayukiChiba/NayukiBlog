---
// 🚀 静态预渲染
export const prerender = true;

import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="About Me | Nayuki Blog">
    <div class="container readme-style">
        <div class="profile-header">
            <span class="deco deco-ring" aria-hidden="true"></span>
            <span class="deco deco-square" aria-hidden="true"></span>
            <span class="deco deco-plus" aria-hidden="true">+</span>
            <div class="avatar-container">
                <img src="/profile.png" alt="Nayuki" class="avatar" onerror="this.src='https://ui-avatars.com/api/?name=Nayuki&background=0D8ABC&color=fff'"/>
            </div>
            <h1 class="profile-name">卟瓿钚</h1>
        </div>

        <p class="center-text">
            <a href="https://github.com/NayukiChiba">
                <img src="https://readme-typing-svg.demolab.com?font=Fira+Code&weight=600&size=28&duration=3000&pause=1000&color=6AD3F7&center=true&vCenter=true&random=false&width=500&lines=Hi+there+%F0%9F%91%8B+I'm+MekoNayuki;Welcome+to+my+GitHub+Profile!" alt="Typing SVG" />
            </a>
        </p>

        <p class="center-text">
             <b>学生</b> | 热爱编程与人工智能
        </p>
        
        <div class="intro-text" style="text-align: center; margin: 2rem 0; color: var(--color-text-light);">
            <p>这里是我的个人博客，平常写一些自己的小巧思，日常</p>
            <p>目前是武汉大学数学系大四在读</p>
            <p>即将成为武汉大学人工智能学院研究生</p>
            <p>我的邮箱是: MekoNayuki@gmail.com</p>
        </div>

        <hr />
        
        <h2>经历</h2>
        <div class="experience-grid">
            <!-- 卡片: 武汉大学 -->
            <a href="https://www.whu.edu.cn/" target="_blank" class="xp-card">
                <div class="xp-icon">
                    <img
                        src="https://img.yumeko.site/file/blog/cover/1780736855881.png"
                        alt="武汉大学"
                        style="margin: 0;"
                    />
                </div>
                <div class="xp-info">
                    <span class="xp-title">武汉大学</span>
                    <span class="xp-desc"
                        >本科 / 数据科学与大数据技术</span
                    >
                </div>
                <div class="xp-arrow">↗</div>
            </a>

            <a href="https://sai.whu.edu.cn/" target="_blank" class="xp-card">
                <div class="xp-icon">
                    <img
                        src="https://img.yumeko.site/file/blog/cover/1780736855881.png"
                        alt="武汉大学"
                        style="margin: 0;"
                    />
                </div>
                <div class="xp-info">
                    <span class="xp-title">武汉大学人工智能学院</span>
                    <span class="xp-desc">研究生 / 人工智能</span>
                </div>
                <div class="xp-arrow">↗</div>
            </a>
        </div>
        

        <hr />

        <h2>技术栈</h2>

        <p class="center-flex-wrap">
            <a href="https://www.java.com/" target="_blank" rel="noopener noreferrer" aria-label="Java">
                <img src="/java.svg" height="48" width="48" alt="Java" />
            </a>

            <a href="https://www.rust-lang.org/" target="_blank" rel="noopener noreferrer" aria-label="Rust">
                <img src="/rust.svg" height="48" width="48" alt="Rust" />
            </a>

            <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" aria-label="Astro">
                <img src="/astro.svg" height="48" width="48" alt="Astro" />
            </a>

            <a href="https://developer.mozilla.org/docs/Web/JavaScript" target="_blank" rel="noopener noreferrer" aria-label="JavaScript">
                <img src="/javascript.svg" height="48" width="48" alt="JavaScript" />
            </a>

            <a href="https://www.docker.com/" target="_blank" rel="noopener noreferrer" aria-label="Docker">
                <img src="/docker.svg" height="48" width="48" alt="Docker" />
            </a>

            <a href="https://www.mysql.com/" target="_blank" rel="noopener noreferrer" aria-label="MySQL">
                <img src="/mysql.svg" height="48" width="48" alt="MySQL" />
            </a>

            <a href="https://www.postgresql.org/" target="_blank" rel="noopener noreferrer" aria-label="PostgreSQL">
                <img src="/postgresql.svg" height="48" width="48" alt="PostgreSQL" />
            </a>

            <a href="https://www.python.org/" target="_blank" rel="noopener noreferrer" aria-label="Python">
                <img src="/python.svg" height="48" width="48" alt="Python" />
            </a>

            <a href="https://pytorch.org/" target="_blank" rel="noopener noreferrer" aria-label="PyTorch">
                <img src="/pytorch.svg" height="48" width="48" alt="PyTorch" />
            </a>

            <a href="https://isocpp.org/" target="_blank" rel="noopener noreferrer" aria-label="C++">
                <img src="/cpp.svg" height="48" width="48" alt="C++" />
            </a>

            <a href="https://vuejs.org/" target="_blank" rel="noopener noreferrer" aria-label="Vue.js">
                <img src="/vue.svg" height="48" width="48" alt="Vue.js" />
            </a>

            <a href="https://ys.mihoyo.com/" target="_blank" rel="noopener noreferrer" aria-label="Genshin Impact">
                <img src="/genshin.webp" height="48" width="48" alt="Genshin Impact" />
            </a>
        </p>


        <hr />

        <div>&nbsp;</div>
    </div>
</PageLayout>

<style>
    .container {
        /* 放宽内层容器：外层 main 已限 1220px */
        max-width: 100%;
        padding: 2rem 1.5rem 4rem;
        color: var(--color-text);
        line-height: 1.6;
    }

    /* 节标题：纯色短杠 + 呼应圆点 */
    h2 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-top: 2rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        position: relative;
    }

    h2::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 2.5rem;
        height: 4px;
        background: var(--color-primary);
        opacity: 0.85;
        border-radius: var(--radius-full);
    }

    h2::before {
        content: "";
        position: absolute;
        left: calc(2.5rem + 0.5rem);
        bottom: 0;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--radial-c2);
    }

    ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1rem;
    }

    li {
        margin-bottom: 0.5rem;
    }

    /* 分隔线：渐隐线 + 中心旋转方点 */
    hr {
        border: none;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--color-border) 18%,
            var(--color-border) 82%,
            transparent
        );
        margin: 2.5rem 0;
        position: relative;
        overflow: visible;
    }

    hr::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) rotate(45deg);
        width: 7px;
        height: 7px;
        background: var(--color-secondary);
        border-radius: 2px;
        box-shadow: 0 0 0 5px var(--color-bg);
    }

    img {
        max-width: 100%;
        height: auto;
    }

    /* 优化 Markdown 样式 */
    .readme-style p {
        margin-bottom: 1rem;
    }

    .readme-style .center-text,
    .readme-style .center-block {
        text-align: center;
    }
    
    /* 技术栈：一行五个，居中对齐 */
    .readme-style .center-flex-wrap {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        justify-items: center;
        gap: 0.75rem 0.5rem;
        max-width: 480px;
        margin-left: auto;
        margin-right: auto;
    }

    @media (max-width: 479px) {
        .readme-style .center-flex-wrap {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    /* 技术栈图标间距 */
    .readme-style p img {
        margin: 0 4px;
        vertical-align: middle;
    }

    /* 技术栈图标：hover 轻抬 + 主题浅底 */
    .center-flex-wrap a {
        display: inline-flex;
        padding: 0.375rem;
        border-radius: var(--radius-md);
        transition:
            transform 0.25s var(--ease-out),
            background-color 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out);
    }

    .center-flex-wrap a:hover {
        transform: translateY(-3px);
        background: color-mix(in srgb, var(--radial-c1), transparent 93%);
        box-shadow: var(--shadow-sm);
    }

    /* --- Profile Header --- */
    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 2rem 0 1.5rem;
        position: relative;
    }

    /* 头像：纯色描边圆环 */
    .avatar-container {
        width: 126px;
        height: 126px;
        border-radius: 50%;
        overflow: hidden;
        margin-bottom: 1rem;
        padding: 3px;
        background: var(--color-primary);
        box-shadow: var(--shadow-md);
    }

    .avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid var(--color-card-bg);
    }

    .profile-name {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin: 0;
    }

    /* 几何装饰（纯装饰元素） */
    .deco {
        position: absolute;
        pointer-events: none;
        user-select: none;
    }

    /* 几何装饰描边：中性灰 */
    .deco-ring {
        top: 6px;
        left: calc(50% - 112px);
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 1.5px solid #d8dce6;
    }

    .deco-square {
        bottom: 48px;
        right: calc(50% - 114px);
        width: 12px;
        height: 12px;
        border-radius: 3px;
        border: 1.5px solid #d8dce6;
        transform: rotate(45deg);
    }

    .deco-plus {
        top: 58%;
        left: calc(50% - 152px);
        font-family: var(--font-display);
        font-size: 1rem;
        line-height: 1;
        color: rgba(20, 22, 31, 0.18);
    }

    /* --- 经历 (Experience) 卡片 --- */
    /* 经历卡：一行两个 */
    .experience-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    @media (max-width: 639px) {
        .experience-grid {
            grid-template-columns: 1fr;
        }
    }

    .xp-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        text-decoration: none;
        transition:
            transform 0.25s var(--ease-out),
            box-shadow 0.25s var(--ease-out),
            border-color 0.25s var(--ease-out);
        cursor: pointer;
        box-shadow: var(--shadow-xs);
        width: 100%;
        position: relative;
        overflow: hidden;
    }

    .xp-card:hover {
        border-color: color-mix(in srgb, var(--radial-c1), transparent 70%);
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
    }

    .xp-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--radial-c1), transparent 92%);
        border-radius: var(--radius-md);
        padding: 0.5rem;
    }
    .xp-icon img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .xp-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
    }
    .xp-title {
        font-weight: 600;
        color: var(--color-text);
        font-size: 1rem;
    }
    .xp-desc {
        color: var(--color-text-light);
        font-size: 0.875rem;
    }
    .xp-arrow {
        color: var(--color-text-muted);
        font-size: 1.25rem;
        transition:
            color 0.25s var(--ease-out),
            transform 0.25s var(--ease-out);
    }
    .xp-card:hover .xp-arrow {
        color: var(--color-primary);
        transform: translate(2px, -2px);
    }

    @media (max-width: 768px) {
        .xp-card {
            padding: 0.875rem 1rem;
        }

        .xp-icon {
            width: 40px;
            height: 40px;
        }

        .deco {
            display: none;
        }
    }

    /* 减动效偏好：关闭过渡 */
    @media (prefers-reduced-motion: reduce) {
        .xp-card,
        .xp-arrow,
        .center-flex-wrap a {
            transition: none;
        }
    }
</style>
